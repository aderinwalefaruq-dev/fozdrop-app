{
  "expo": {
    "name": "FOZDROP",
    "slug": "fozdropdelivery",
    "scheme": "fozdropdelivery",
    "version": "1.0.105",
    "orientation": "portrait",
           "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
    "bundleIdentifier": "com.fozdrop.app",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
  "adaptiveIcon": {
    "backgroundColor": "#ffffff"
},
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "package": "com.fozdrop.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-sqlite",
      "expo-font",
      "expo-system-ui",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Fozdrop to access your camera to take profile photos",
          "photosPermission": "Allow Fozdrop to access your photo library to choose a profile picture"
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F25C19",
          "sounds": ["./assets/sounds/order_alert.wav"]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ]
    ],
    "router": {
      "root": "src"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
