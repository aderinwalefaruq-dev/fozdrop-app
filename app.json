{
  "expo": {
    "name": "FOZDROP",
    "slug": "fozdropdelivery",
    "scheme": "fozdropdelivery",
    "version": "1.0.105",
    "orientation": "portrait",
    "icon": "https://miaoda-edit-image.s3cdn.medo.dev/c7vn93er6ayp/IMG-dcn3ijg4cphc.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.miaoda.appc7vn93er6ayp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "package": "com.miaoda.appc7vn93er6ayp"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-sqlite",
      "expo-font",
      "expo-system-ui",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Fozdrop to access your camera to take profile photos",
          "photosPermission": "Allow Fozdrop to access your photo library to choose a profile picture"
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "router": {
      "root": "src"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}